# ========== Agnes API（免费全模态: 文本+图片+视频）==========
AGNES_API_KEY=your_agnes_api_key_here
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_TEXT_MODEL=agnes-2.5-flash
AGNES_IMAGE_MODEL=agnes-image-2.1-flash
AGNES_IMAGE_MODELS=agnes-image-2.1-flash,agnes-image-2.5-flash
AGNES_VIDEO_MODEL=agnes-video-v2.0
AGNES_VIDEO_MODELS=agnes-video-v2.0,agnes-video-2.5-flash
# AGNES_PROXY=http://127.0.0.1:7890

# ========== DeepSeek API（复杂推理）==========
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_PROXY=http://127.0.0.1:7890

# ========== Router 服务端口 ==========
ROUTER_PORT=8800
ROUTER_HOST=127.0.0.1

# ========== 分类器自定义（可选，不设则用内置默认）==========
# 自定义复杂推理关键词（逗号分隔）
# CLASSIFIER_COMPLEX_KEYWORDS=分析,代码,架构,数学,算法,推理
# 自定义简单任务关键词
# CLASSIFIER_SIMPLE_KEYWORDS=翻译,你好,谢谢,总结,摘要
# 复杂度阈值（有任何复杂信号就走推理后端，默认 1）
# CLASSIFIER_COMPLEXITY_THRESHOLD=1
# 短消息上限（字符数，低于此值走简单后端，默认 200）
# CLASSIFIER_SHORT_LIMIT=200
