# ============================================================
# 不绘来世 (agnes-router) 环境变量模板
# 用法：复制本文件为 .env，填入你自己的 API Key 后保存。
#   Windows:  copy .env.example .env
#   macOS/Linux:  cp .env.example .env
# 带默认值的项可留空；KEY 类项必填。
# ============================================================

# ---- Agnes（图片/视频生成 + 视觉对话）----
# 必填：你的 Agnes API Key
AGNES_API_KEY=
# 以下可选，留空使用默认值
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_TEXT_MODEL=agnes-2.5-flash
AGNES_IMAGE_MODEL=agnes-image
AGNES_IMAGE_MODELS=agnes-image
AGNES_VIDEO_MODEL=agnes-video
AGNES_VIDEO_MODELS=agnes-video

# ---- DeepSeek（复杂推理 / 联网搜索）----
# 必填：你的 DeepSeek API Key
DEEPSEEK_API_KEY=
# 以下可选，留空使用默认值
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ---- 本地服务监听 ----
# 可选，留空使用默认 127.0.0.1:8800
ROUTER_PORT=8800
ROUTER_HOST=127.0.0.1
